# FitTrack backend — variabili d'ambiente
# Copia questo file in `.env` e compila i valori.
# NON committare mai `.env` (è già in .gitignore).

# Database. Per l'ambiente locale Docker usa l'host `db` (vedi docker-compose.local.yml).
DATABASE_URL="postgresql://fittrack:fittrack@db:5432/fittrack?schema=public"

# Segreto per firmare i JWT (genera uno tuo, es. `openssl rand -hex 32`)
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

# Porta HTTP del server
PORT=3000

# Origini consentite dal CORS, separate da virgola
CORS_ORIGIN="http://localhost:5173"

# Chiave API per le funzioni AI (Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
