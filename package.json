{
  "name": "fittrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-precache.mjs",
    "preview": "vite preview",
    "mobile": "node scripts/serve-https.mjs",
    "docker:local:up": "docker compose -f docker-compose.local.yml up -d",
    "docker:local:down": "docker compose -f docker-compose.local.yml down",
    "docker:local:logs": "docker compose -f docker-compose.local.yml logs -f backend",
    "docker:local:reset": "docker compose -f docker-compose.local.yml down -v && docker compose -f docker-compose.local.yml up -d"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "lucide": "^1.27.0"
  }
}
